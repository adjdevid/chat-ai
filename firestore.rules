rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and token limit document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User chat sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(sessionId);
      }
    }

    // Guest quotas - client read-only, server-write only
    match /guest_quotas/{deviceId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
